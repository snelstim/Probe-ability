        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID (optional if only one instance)."
        },
        "target_temp": {
          "name": "Target temperature",
          "description": "Target internal temperature in °C."
        },
        "probe_mode": {
          "name": "Probe mode",
          "description": "combined = all probes share one cook, individual = each probe is independent."
        },
        "probe_index": {
          "name": "Probe index",
          "description": "Which probe to start: its number minus 1 (0–3), so probe 4 is 3 even if probes 2 and 3 are unused. Only used in individual mode."
        }
      }
    },
    "stop_cook": {
      "name": "Stop cook",
      "description": "Stop a cook and clear readings.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID (optional if only one instance)."
        },
        "probe_index": {
          "name": "Probe index",
          "description": "Which probe to stop: its number minus 1 (0–3). Omit to stop all probes."
        }
      }
    },
    "set_target": {
      "name": "Set target temperature",
      "description": "Update the target temperature for an active cook.",
      "fields": {
        "entry_id": {
          "name": "Entry ID",
          "description": "Config entry ID (optional if only one instance)."
        },
        "target_temp": {
          "name": "Target temperature",
          "description": "New target internal temperature in °C."
        },
        "probe_index": {
          "name": "Probe index",
          "description": "Which probe to update: its number minus 1 (0–3). Omit to update all probes."
        }
      }
    }
